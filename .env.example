# ===================================
# Spring Boot Application Configuration
# ===================================

# JWT Secret Key (use a strong random key in production)
APP_JWT_SECRET=your_secure_jwt_secret_key_here

# JWT Token Expiration (in milliseconds, default: 24 hours)
APP_JWT_EXPIRATION_MS=86400000

# ===================================
# Database Configuration (if using MySQL)
# ===================================
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/expense_tracker
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_db_password

# ===================================
# Frontend Configuration
# ===================================
REACT_APP_API_URL=http://localhost:8080/api
